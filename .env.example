# Получите токен тестового бота у @BotFather.
BOT_TOKEN=

# Случайный секрет, одинаковый для API и бота.
API_SECRET_TOKEN=
VIDEO_API_URL=http://127.0.0.1:8000

# HTTPS-адрес ngrok с обязательным путём /app/.
WEBAPP_URL=https://your-domain.ngrok-free.app/app/
MINI_APP_AUTH_MAX_AGE=86400

# DATA_DIR=./data

# Общий бюджет обработки всех медиаэндпоинтов одного процесса API.
MEDIA_CONCURRENCY=2
MEDIA_JOB_TIMEOUT_SECONDS=240
FFMPEG_THREADS=2
SOURCE_TTL_SECONDS=3600
MEDIA_CLEANUP_INTERVAL_SECONDS=300

# Ограничения Compose: подберите по ресурсам сервера и нагрузочным проверкам.
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=2g
BOT_CPU_LIMIT=0.5
BOT_MEMORY_LIMIT=384m

# Проверенные локальные снимки SQLite; внешнее хранение настраивается отдельно.
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_COUNT=48
